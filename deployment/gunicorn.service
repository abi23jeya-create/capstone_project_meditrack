[Unit]
Description=MediTrack Gunicorn Service
After=network.target

[Service]
User=ubuntu
Group=www-data
WorkingDirectory=/home/ubuntu/meditrack-production
EnvironmentFile=/home/ubuntu/meditrack-production/.env
ExecStart=/home/ubuntu/meditrack-production/venv/bin/gunicorn --workers 3 --bind 127.0.0.1:8000 wsgi:app
Restart=always

[Install]
WantedBy=multi-user.target
